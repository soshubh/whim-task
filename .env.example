# ---------------------------------------------------------------------------
# Supabase (required)
# Dashboard → Project Settings → API
# ---------------------------------------------------------------------------
# Use the project URL only. Do NOT add /rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Email OTP (configured in Supabase Dashboard, not in this file)
# Authentication → SMTP Settings → Brevo SMTP
# Sender example: whimsaas@gmail.com
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Google Calendar (OAuth) — optional until Calendar sync is enabled
# Google Cloud Console → APIs & Services → Credentials → OAuth client
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Authorized redirect URI example:
# https://task.whimsaas.online/api/google/callback
# http://localhost:3000/api/google/callback

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
